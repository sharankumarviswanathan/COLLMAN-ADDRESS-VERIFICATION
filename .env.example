# Server Network Configuration
PORT=5000
NODE_ENV=production

# Security Secrets (Replace with long, random strings in production)
JWT_SECRET=collman_address_verification_production_secret_key_2026_xyz
VERIFY_SESSION_SECRET=collman_employee_verify_session_token_key_2026_xyz

# Geocoding Provider: 'OpenStreetMap / Nominatim' or 'Google Maps'
