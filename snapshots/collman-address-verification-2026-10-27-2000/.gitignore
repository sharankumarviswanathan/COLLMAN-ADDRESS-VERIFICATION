# Dependencies
node_modules/
client/node_modules/

# Production Build Output
client/dist/

# SQLite Database and Journals (keep in backup instead of public git)
server/db/*.db-journal
server/db/*.db-wal
server/db/*.db-shm

# Runtime Uploads & Generated Downloads
server/uploads/*
!server/uploads/.gitkeep
server/downloads/*
!server/downloads/.gitkeep

# Application & Process Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment secrets
.env
.env.local
.env.*.local

# OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
